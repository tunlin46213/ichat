{
  "expo": {
    "name": "iChat",
    "slug": "ichat",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ichat",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.tunlin.ichat",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "audio",
          "remote-notification"
        ]
      }
    },
    "android": {
      "package": "com.tunlin.ichat",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "name": "iChat",
      "shortName": "iChat",
      "themeColor": "#208AEF",
      "backgroundColor": "#000000"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "iChat uses the microphone to record voice messages and for voice calls."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "iChat lets you choose photos to send in chats and to use as your profile picture.",
          "cameraPermission": "iChat uses the camera to take photos to send in chats."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "iChat lets you choose photos to send in chats and to use as your profile picture.",
          "savePhotosPermission": "iChat saves photos from your chats to your library when you tap Save.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "iChat uses your location only when you choose to share it in a chat.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#208AEF"
        }
      ],
      "@stream-io/video-react-native-sdk",
      [
        "@config-plugins/react-native-webrtc",
        {
          "microphonePermission": "iChat uses the microphone for voice calls.",
          "cameraPermission": "iChat uses the camera for video in calls."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24
          }
        }
      ],
      "expo-asset",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "iChat uses the microphone to record voice messages and for voice calls.",
          "speechRecognitionPermission": "iChat turns voice messages into text on your phone when you tap Transcribe."
        }
      ]
    ],
    "extra": {
      "pushWorkerUrl": "https://ichat-push.tunlin-tlin-ac2.workers.dev",
      "webPushVapidKey": "",
      "streamApiKey": "uc5wwkmp728q"
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
