rules_version = '2';

// Deploy: Firebase console → Firestore Database → Rules → paste → Publish
// (or `firebase deploy --only firestore:rules`).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Web admin dashboard (/admin): uids in config/admins.uids (edited in the console only).
    function isAdmin() {
      let admins = /databases/$(database)/documents/config/admins;
      return signedIn() && exists(admins) && request.auth.uid in get(admins).data.get('uids', []);
    }

    // Invite-only (config/invites.enabled): only listed emails may use iChat. Others can
    // still create a sign-in account, but can't see anyone or send anything.
    function invited() {
      let inv = /databases/$(database)/documents/config/invites;
      return !exists(inv)
        || get(inv).data.get('enabled', false) != true
        || (request.auth.token.email is string
            && request.auth.token.email.lower() in get(inv).data.get('emails', []));
    }

    // A signed-in person who is allowed to use the app.
    function member() {
      return signedIn() && invited();
    }

    function blockList(uid) {
      return /databases/$(database)/documents/blocks/$(uid);
    }

    // true if `uid` has blocked the current user
    function blockedBy(uid) {
      return exists(blockList(uid)) && request.auth.uid in get(blockList(uid)).data.blocked;
    }

    // Public profiles (no email). Any signed-in user can read them for the user list;
    // only the owner can create or change their own profile.
    match /users/{userId} {
      allow read: if member();
      allow create, update: if member()
        && request.auth.uid == userId
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 40
        && (!('bio' in request.resource.data)
            || (request.resource.data.bio is string && request.resource.data.bio.size() <= 100));
      allow delete: if signedIn() && request.auth.uid == userId;

      // Private per-user data (push tokens). Only the owner; Cloud Functions bypass rules.
      match /private/{docId} {
        allow read, write: if signedIn() && request.auth.uid == userId;
      }

      // My stories after their 24 hours (small copies). Only I can see them.
      match /storyArchive/{storyId} {
        allow read, write: if signedIn() && request.auth.uid == userId;
      }
    }

    // App settings that change without a new build (worker URL, minimum build, invites).
    // `admins` only in the Firebase console; the others also from the admin dashboard.
    match /config/{docId} {
      allow read: if signedIn();
      allow write: if docId != 'admins' && isAdmin();
    }

    // My block list. Private: only I can read or change it.
    match /blocks/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    // Abuse reports. Users can file them but never read them; review in the console.
    match /reports/{reportId} {
      // The admin dashboard lists them and can dismiss them.
      allow read, delete: if isAdmin();
      allow create: if member()
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.reportedUserId is string
        && request.resource.data.reason is string;
    }

    // 24-hour stories. Any member may list them (the app hides people they blocked or
    // muted); only the owner creates or deletes; others may only add themselves to
    // `viewers` and react. Expired ones are hidden by the app and deleted hourly by the
    // push worker's cron (and by the owner's phone).
    match /stories/{storyId} {
      allow read: if member();
      allow create: if member()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.kind in ['photo', 'text']
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt <= request.time + duration.value(25, 'h')
        && (!('text' in request.resource.data)
            || (request.resource.data.text is string && request.resource.data.text.size() <= 300))
        && (request.resource.data.kind == 'text'
            ? request.resource.data.text.size() > 0
            // existsAfter: the photo doc is written in the same batch.
            : existsAfter(/databases/$(database)/documents/storyMedia/$(storyId)))
        && !('viewers' in request.resource.data)
        && !('reactions' in request.resource.data);
      // Others may only add themselves to `viewers` and set / remove their own reaction.
      allow update: if member()
        && resource.data.ownerId != request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewers', 'reactions'])
        && request.resource.data.get('viewers', {})
             .diff(resource.data.get('viewers', {}))
             .affectedKeys().hasOnly([request.auth.uid])
        && request.resource.data.get('reactions', {})
             .diff(resource.data.get('reactions', {}))
             .affectedKeys().hasOnly([request.auth.uid])
        && (!(request.auth.uid in request.resource.data.get('reactions', {}))
            || (request.resource.data.reactions[request.auth.uid] is string
                && request.resource.data.reactions[request.auth.uid].size() <= 16));
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }

    // Story photos (base64). People the owner blocked can't open them.
    match /storyMedia/{storyId} {
      allow get: if member() && !blockedBy(resource.data.ownerId);
      allow create: if member()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.data is string
        && request.resource.data.data.size() <= 950000
        && request.resource.data.mime == 'image/jpeg';
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }

    // Moments: posts with text and up to 9 photos that stay until the author deletes
    // them. Every member can read them, like (only their own key) and comment.
    match /moments/{momentId} {
      allow read: if member();
      allow create: if member()
        && request.resource.data.authorId == request.auth.uid
        && (!('text' in request.resource.data)
            || (request.resource.data.text is string && request.resource.data.text.size() <= 1000))
        && request.resource.data.photos is list
        && request.resource.data.photos.size() <= 9
        && (request.resource.data.photos.size() > 0 || request.resource.data.get('text', '').size() > 0)
        && !('likes' in request.resource.data)
        && request.resource.data.get('commentCount', 0) == 0;
      allow update: if member() && (
        // Like / unlike: only my own entry.
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes'])
          && request.resource.data.get('likes', {})
               .diff(resource.data.get('likes', {}))
               .affectedKeys().hasOnly([request.auth.uid]))
        ||
        // The comment counter moves by one with each comment added or removed.
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentCount'])
          && request.resource.data.commentCount is int
          && math.abs(request.resource.data.commentCount - resource.data.get('commentCount', 0)) <= 1)
      );
      allow delete: if signedIn() && resource.data.authorId == request.auth.uid;

      match /comments/{commentId} {
        allow read: if member();
        allow create: if member()
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500
          && exists(/databases/$(database)/documents/moments/$(momentId));
        // Like / unlike a comment: only my own entry in `likes`.
        allow update: if member()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes'])
          && request.resource.data.get('likes', {})
               .diff(resource.data.get('likes', {}))
               .affectedKeys().hasOnly([request.auth.uid]);
        // The commenter, or the moment's author (also when deleting the whole moment).
        allow delete: if signedIn()
          && (resource.data.authorId == request.auth.uid
              || get(/databases/$(database)/documents/moments/$(momentId)).data.authorId == request.auth.uid);
      }
    }

    // Moment photos (base64, ≤ 1080 px). People the author blocked can't open them.
    match /momentMedia/{photoId} {
      allow get: if member() && !blockedBy(resource.data.ownerId);
      allow create: if member()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.data is string
        && request.resource.data.data.size() <= 950000
        && request.resource.data.mime == 'image/jpeg';
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }

    // 1:1 chats. chatId = the two user IDs sorted and joined with "_".
    match /chats/{chatId} {
      function isMember() {
        return request.auth.uid in resource.data.members;
      }

      allow read: if signedIn() && isMember();
      allow create: if member()
        && request.resource.data.members is list
        && request.resource.data.members.size() == 2
        && request.auth.uid in request.resource.data.members
        && chatId == request.resource.data.members[0] + '_' + request.resource.data.members[1];
      // Members may update previews, read markers, typing, etc., but never membership.
      allow update: if signedIn() && isMember()
        && request.resource.data.members == resource.data.members;

      // Photos / voice notes as base64 (free-plan alternative to Cloud Storage).
      // Written in the same batch as their message; never changed afterwards (old ones may be cleared).
      match /media/{mediaId} {
        function members() {
          return get(/databases/$(database)/documents/chats/$(chatId)).data.members;
        }

        allow read: if signedIn() && request.auth.uid in members();
        allow create: if member()
          && request.auth.uid in members()
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.data is string
          && request.resource.data.data.size() <= 950000
          && request.resource.data.mime in ['image/jpeg', 'audio/mp4', 'audio/webm'];
        // Settings → Storage: either member may clear photos / voice older than 30 days
        // (the free plan has 1 GB). Deleting one that is already gone is a no-op.
        allow delete: if signedIn()
          && request.auth.uid in members()
          && (resource == null || resource.data.createdAt < request.time - duration.value(30, 'd'));
      }

      match /messages/{messageId} {
        function chatMembers() {
          return get(/databases/$(database)/documents/chats/$(chatId)).data.members;
        }

        function otherMember() {
          let m = chatMembers();
          return m[0] == request.auth.uid ? m[1] : m[0];
        }

        function changed() {
          return request.resource.data.diff(resource.data).affectedKeys();
        }

        function validText(text) {
          return text is string && text.size() > 0 && text.size() <= 4000;
        }

        function validBody() {
          let d = request.resource.data;
          let type = d.get('type', 'text');
          return (type == 'text' && validText(d.text))
            || (type in ['image', 'audio']
                && d.mediaId is string
                // existsAfter: the media doc is created in the same batch.
                && existsAfter(/databases/$(database)/documents/chats/$(chatId)/media/$(d.mediaId)))
            // Call log entry, written by the caller when the call ends.
            || (type == 'call'
                && d.callType in ['voice', 'video']
                && d.callStatus in ['answered', 'missed']
                && d.durationMs is number)
            // Shared map location.
            || (type == 'location'
                && d.lat is number && d.lat >= -90 && d.lat <= 90
                && d.lng is number && d.lng >= -180 && d.lng <= 180);
        }

        // A scheduled message carries its send time as createdAt (within 30 days).
        function validSchedule() {
          let d = request.resource.data;
          return !d.get('scheduled', false)
            || (d.createdAt is timestamp
                && d.createdAt > request.time
                && d.createdAt < request.time + duration.value(30, 'd'));
        }

        allow read: if signedIn() && request.auth.uid in chatMembers();

        // Sender must be me, and the other person must not have blocked me.
        allow create: if member()
          && request.auth.uid in chatMembers()
          && request.resource.data.senderId == request.auth.uid
          && validBody()
          && validSchedule()
          && !blockedBy(otherMember());

        // Only a scheduled message, by its sender, before its send time ("Cancel").
        allow delete: if signedIn()
          && resource.data.senderId == request.auth.uid
          && resource.data.get('scheduled', false) == true
          && resource.data.createdAt > request.time;

        allow update: if signedIn() && request.auth.uid in chatMembers() && (
          // Reactions: each person may only add/change/remove their own.
          (changed().hasOnly(['reactions'])
            && request.resource.data.reactions
                 .diff(resource.data.get('reactions', {}))
                 .affectedKeys().hasOnly([request.auth.uid]))
          ||
          // Edit: the sender, text messages only, within 15 minutes of sending.
          (resource.data.senderId == request.auth.uid
            && changed().hasOnly(['text', 'editedAt'])
            && resource.data.get('type', 'text') == 'text'
            && !resource.data.get('deleted', false)
            && validText(request.resource.data.text)
            && request.time < resource.data.createdAt + duration.value(15, 'm'))
          ||
          // Unsend: only the sender, and only to blank the message.
          (resource.data.senderId == request.auth.uid
            && changed().hasOnly(['deleted', 'text', 'replyTo'])
            && request.resource.data.deleted == true
            && request.resource.data.text == '')
        );
      }
    }
  }
}
